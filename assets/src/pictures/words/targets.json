  {
   "id": "b-statement",
   "x": 72,
   "y": 6737,
   "w": 1011,
   "h": 330,
   "em": 66,
   "base": 59.703125,
   "lines": 4,
   "text": "I'm Hamdan. I study data science and AI at United Arab Emirates University, and I like software that is finished."
  },
  {
   "id": "b-finished",
   "x": 72,
   "y": 7107,
   "w": 1033,
   "h": 224,
   "em": 60,
   "base": 54.296875,
   "lines": 3,
   "text": "Finished means it has a live address, it works on a phone, and you can try it without asking me first."
  },
  {
   "id": "b-quote",
   "x": 72,
   "y": 7368,
   "w": 547,
   "h": 224,
   "em": 60,
   "base": 54.296875,
   "lines": 3,
   "text": "I would rather show a blank than a guess."
  },
  {
   "id": "j-0",
   "x": 72,
   "y": 7629,
   "w": 1090,
   "h": 224,
   "em": 60,
   "base": 54.296875,
   "lines": 3,
   "text": "I looked after the computers at my father's business, for a staff of ten. I was the whole IT department."
  },
  {
   "id": "j-1",
   "x": 72,
   "y": 7890,
   "w": 1046,
   "h": 299,
   "em": 60,
   "base": 54.296875,
   "lines": 4,
   "text": "First place at the AUS High School Computing Competition with Digital EcoHome, a smart-home app that read eleven Arduino sensors."
  },
  {
   "id": "j-2",
   "x": 72,
   "y": 8226,
   "w": 1034,
   "h": 224,
   "em": 60,
   "base": 54.296875,
   "lines": 3,
   "text": "Finished school at the top of my class, and started Data Science and AI at UAEU."
  },
  {
   "id": "j-3",
   "x": 72,
   "y": 8487,
   "w": 1094,
   "h": 374,
   "em": 60,
   "base": 54.296875,
   "lines": 5,
   "text": "Two browser games for Hack Club Terra, a price model from 109,706 Dubai property sales, then nine builds in seventeen days for one TinyFish bounty round."
  },
  {
   "id": "s-falaj",
   "x": 72,
   "y": 8898,
   "w": 913,
   "h": 149,
   "em": 60,
   "base": 54.296875,
   "lines": 2,
   "text": "UAEU's public website as ten MCP tools, read live with TinyFish."
  },
  {
   "id": "s-backed",
   "x": 72,
   "y": 9084,
   "w": 760,
   "h": 149,
   "em": 60,
   "base": 54.296875,
   "lines": 2,
   "text": "Who funded companies like yours, with the proof."
  },
  {
   "id": "s-standing",
   "x": 72,
   "y": 9270,
   "w": 817,
   "h": 224,
   "em": 60,
   "base": 54.296875,
   "lines": 3,
   "text": "What the official register says about a person or a business, right now, with the proof."
  },
  {
   "id": "s-fineprint",
   "x": 72,
   "y": 9531,
   "w": 905,
   "h": 224,
   "em": 60,
   "base": 54.296875,
   "lines": 3,
   "text": "A dated record of the web's small print: pricing pages, terms, policies and fee tables."
  },
  {
   "id": "s-redtape",
   "x": 72,
   "y": 9792,
   "w": 897,
   "h": 299,
   "em": 60,
   "base": 54.296875,
   "lines": 4,
